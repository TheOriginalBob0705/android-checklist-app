        android:roundIcon="@mipmap/tick_icon_round"
        android:theme="@style/Theme.Checklist">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
